      "REDZONE": 10,
      "POSSESSION": 11,
      "STATUS": 12,
      "TEAM_IDX": 13,
      "START_TIME": 14,
      "AWAY_RECORD": 15,
      "HOME_RECORD": 16,
      "VIBRATE": 17,
      "LAST_PLAY": 18,
      "NEXT_GAME": 19,
      "BATTERY_BAR": 20,
      "TICKER": 21,
      "DOWN_TEXT": 22,
      "SCORE_EVENT": 23,
      "NETWORK": 24,
      "FEATURED_TAG": 25,
      "TICKER_SPEED": 27,
      "AWAY_STATS": 28,
      "HOME_STATS": 29,
      "AWAY_TURNOVERS": 30,
