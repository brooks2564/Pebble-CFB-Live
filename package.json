{
  "name": "CFB Live",
  "author": "Brooman Inks",
  "version": "1.0.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "pebble-clay": "github:brooks2564/pebble-clay-flint"
