        },
        {
          "type": "png",
          "name": "FOOTBALL_BA",
          "file": "images/FOOTBALL_BA.png",
          "targetPlatforms": [
            "aplite",
            "basalt",
            "diorite",
            "flint"
          ]
        }
      ]
    }
